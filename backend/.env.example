# copy this file to .env and fill in the values (never commit .env)
PORT=9999

# MongoDB connection string (MongoDB Atlas or a local MongoDB)
DATABASE_URL=

# long random text used to sign login tokens
# make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# the deployed frontend address (http://localhost:5173 is always allowed)
FRONTEND_URL=

# password every new student gets (they log in with college roll number + this)
DEFAULT_STUDENT_PASSWORD=Acadex@123

# first admin account, created with:  npm run createadmin
ADMIN_NAME=Academic Office
ADMIN_EMAIL=admin@acadex.edu
ADMIN_PASSWORD=

# Cloudinary (stores the page images of notes) - from cloudinary.com > Dashboard
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
